{
  "key_column": "invoice_id",
  "field_rules": {
    "amount": {
      "type": "money",
      "tolerance": "0.01",
      "required": true,
      "currency_field": "currency"
    },
    "currency": {
      "type": "text",
      "case_sensitive": false,
      "required": true
    },
    "customer_name": {
      "type": "text",
      "case_sensitive": false,
      "required": false
    },
    "date": {
      "type": "date",
      "format": "%Y-%m-%d",
      "required": true
    }
  }
}
